# Copy to .env (never commit it). Anthropic key is read via ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# anthropic | openai_compat | fake
HACK_PROVIDER=anthropic
HACK_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (empty = don't send; needed for non-5.x models)
HACK_EFFORT=medium
HACK_MAX_TOKENS=16000
HACK_MAX_TURNS=40
# Hard stop for one agent run, in USD (estimate from the price table in src/hack/pricing.py)
HACK_BUDGET_USD=5
# false = tools marked risk="write" return a dry-run message instead of executing
HACK_APPROVE_WRITES=false
# Data policy: label for uploads with none chosen (public | internal | restricted); the most sensitive
# label an external model may receive (public | internal; restricted never leaves); hide identifiers
# from external models; where the model runs ("" detects it, or local | external).
HACK_DEFAULT_SENSITIVITY=internal
HACK_MAX_EXTERNAL=internal
HACK_REDACT_EXTERNAL=true
HACK_PROVIDER_LOCATION=

# Judge model for eval checks of type llm_judge
HACK_JUDGE_MODEL=claude-sonnet-5-5

# openai_compat provider (vLLM / Ollama / llama.cpp). Inside compose: http://ollama:11434/v1
HACK_OPENAI_BASE_URL=http://localhost:11434/v1
HACK_OPENAI_API_KEY=none
# Optional price override for unpriced models, USD per 1M tokens
HACK_PRICE_INPUT_PER_MTOK=
HACK_PRICE_OUTPUT_PER_MTOK=

# Sign-in. Off when no users are set. Add accounts with: uv run python scripts/add_user.py <name>
# (it prompts for the password, then writes both lines below). Sign-offs on a label and the
# "being reviewed by" lock use the signed-in account, so set this for any shared server.
HACK_AUTH_USERS=
# Roles per account: name:role, comma-separated. Only legal opens Restricted contracts and their
# reviews. Empty: every signed-in person reads everything. add_user.py can set it.
HACK_AUTH_ROLES=
HACK_SECRET_KEY=
HACK_REQUIRE_AUTH=false
# Reviews that may call the model on this deployment, in total; empty for no limit.
HACK_MAX_REVIEWS=
